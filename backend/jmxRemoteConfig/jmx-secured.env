JAVA_TOOL_OPTIONS=-Dcom.sun.management.jmxremote -Dcom.sun.management.jmxremote.port=9010 -Dcom.sun.management.jmxremote.rmi.port=9011 -Djava.rmi.server.hostname=127.0.0.1 -Dcom.sun.management.jmxremote.authenticate=true -Dcom.sun.management.jmxremote.password.file=/jmxRemoteConfig/jmxremote.password -Dcom.sun.management.jmxremote.access.file=/jmxRemoteConfig/jmxremote.access -Dcom.sun.management.jmxremote.ssl=true -Djavax.net.ssl.keyStore=/jmxRemoteConfig/jmx.keystore -Djavax.net.ssl.keyStorePassword=baobab